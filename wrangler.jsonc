{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winnetkadentalarts-com",
  "main": "src/index.js",
  "minify": true,
  "build": { "command": "node build.mjs", "watch_dir": "public" },
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.winnetkadentalarts.com", "custom_domain": true },
    { "pattern": "winnetkadentalarts.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Keep variables and secrets set in the dashboard (e.g. PlacesAPI) when Workers Builds deploys.
  "keep_vars": true,
  "workers_dev": true,

  "vars": {
    "NOTIFY_FROM": "website@winnetkadentalarts.com",
    "NOTIFY_TO": "office@wargadds.com"
  },

  // ---- Appointment form e-mail ---------------------------------------------
  // Email Routing is enabled on the zone and the office address is a verified
  // destination. The binding is not pinned to one address, so NOTIFY_TO can be
  // changed to any other verified destination without touching the binding.
  "send_email": [{ "name": "APPOINTMENT_EMAIL" }]

  // ---- Domains ---------------------------------------------------------------
  // Both hostnames are attached as custom domains (see "routes" above); the
  // Worker runs first for every request and redirects the apex to www.

}
